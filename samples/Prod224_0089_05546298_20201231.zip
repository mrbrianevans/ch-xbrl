<head>

    <style type="text/css">
    tr.rowHighlight:hover {
        backgRound: lightBlue !important;
    }

    .rowHighlight:hover td {
        backgRound: transparent;
    }

    /*.divFinalAccount td {
        font: 15px 'Open Sans', sans-serif;
        /*text-align: right;
        font-style: normal;
        font-size: 15px;
        font-family: 'Open Sans', sans-serif;
        padding-right: 1.1mm;
        font-weight: normal;
    }*/

    .renderhtml td {
        text-align: justify !important;
        font-style: normal;
        font-size: 15px;
        font-family: 'Open Sans', sans-serif;
        padding-right: 1.1mm;
        font-weight: normal;
    }

    .divFinalAccount td.u {
        text-decoration: underline;
    }

    .divFinalAccount td.t {
        text-align: justify;
    }

    divFinalAccount TD.bullet {
        text-align: justify;
    }

    .divFinalAccount TD.tu {
        text-decoration: underline;
        text-align: justify;
    }

    .divFinalAccount TD.b {
        font-weight: bold !important;
    }

    .divFinalAccount TD.bu {
        text-decoration: underline;
        font-weight: bold;
    }

    .divFinalAccount TD.bt {
        text-align: justify;
        font-weight: bold;
    }

    .divFinalAccount TD.big {
        text-align: justify;
        font-weight: bold;
        font-size: 22px;
    }

    .hoverElement {
        cursor: pointer;
    }



    .divFinalAccount TD.bc {
        text-align: center;
        font-weight: bold;
    }

    .divFinalAccount TD.i {
        font-style: normal;
    }

    .divFinalAccount TD.bi {
        font-style: normal;
        font-weight: bold;
    }

    .divFinalAccount TD.comp {
        font-style: normal;
    }

    .divFinalAccount TD.grey {
        backgRound-color: #e0e0e0;
        text-align: right;
        font-weight: bold;
    }

    .divFinalAccount TD.greyt {
        backgRound-color: #e0e0e0;
        text-align: justify;
        font-weight: bold;
    }

    .divFinalAccount TD.j {
        text-align: justify;
    }

    .divFinalAccount TD.notes {
        text-align: justify;
    }

    .divFinalAccount TD.black {
        backgRound-color: black;
        text-align: justify;
        font-size: 15px;
        color: white;
        font-weight: bold;
    }

    .divFinalAccount TD.white {
        text-align: justify;
        color: white;
        font-weight: bold;
    }

    .divFinalAccount TD.bcu {
        text-decoration: underline;
        text-align: center;
        font-weight: bold;
    }

    .divFinalAccount TD.c {
        text-align: center;
    }

    .divFinalAccount TD.control {
        text-align: justify;
        font-style: normal;
        color: red;
    }

    .divFinalAccount TD.clientinput {
        border-left-style: solid;
        border-bottom-style: solid;
        border-right-style: solid;
        border-top-style: solid;
        text-align: justify;
        border-color: grey;
        border-width: 1px;
    }

    .divFinalAccount TD.sign {
        text-align: justify;
        font-style: normal;
        vertical-align: bottom;
        font-weight: normal;
    }

    .divFinalAccount TR.h1 {
        height: 4mm;
    }

    .divFinalAccount TR.h2 {
        height: 2mm;
    }

    .divFinalAccount TD.legalst {
        padding-bottom: 2mm;
        text-align: center;
        font-size: 15px;
        font-family: 'Open Sans', sans-serif;
        padding-top: 7mm;
        page-break-after: never;
        font-weight: bold;
    }

    .addNote {
        font-weight: bold !important;
    }

    .divFinalAccount TD.legal {
        text-align: justify;
        font-style: normal;
        font-size: 15px;
        font-family: 'Open Sans', sans-serif;
        font-weight: normal;
    }

    .divFinalAccount TD.legalstA {
        padding-bottom: 2mm;
        text-align: center;
        font-size: 15px;
        font-family: Times;
        padding-top: 7mm;
        page-break-after: avoid;
        font-weight: bold;
    }

    .divFinalAccount TD.legalA {
        text-align: justify;
        font-style: normal;
        font-size: 15px;
        font-family: Times;
        font-weight: normal;
    }

    .divFinalAccount div.address {
        position: absolute;
        left: 10mm;
        top: 42mm;
    }

    .divFinalAccount table.body {
        position: absolute;
        top: 70mm;
    }

    .divFinalAccount hr.1 {
        width: 100%;
        height: 5;
        text-align: center;
        color: black;
    }

    .divFinalAccount hr.2 {
        width: 100%;
        height: 5;
        text-align: center;
        color: black;
    }

    .divFinalAccount hr.3 {
        width: 100%;
        height: 1;
        text-align: center;
        color: black;
    }

    .divFinalAccount hr.4 {
        width: 100%;
        height: 2;
        text-align: center;
        color: black;
    }

    .divFinalAccount input.readonly {
        backgRound-color: #e0e0e0;
    }

    .divFinalAccount input.q {
        height: 30;
        border-style: solid;
        border-color: navy;
        border-width: thin;
    }

    .divFinalAccount div.title {
        font-weight: bold;
    }

    .divFinalAccount #center {
        text-align: center;
    }

    .divFinalAccount p {
        text-align: justify;
    }

    .divFinalAccount p {
        font: normal 15px 'Open Sans', sans-serif;
    }

    .divFinalAccount li {
        font-family: 'Open Sans', sans-serif;
    }

    .divFinalAccount #top {
        border-top-style: solid;
        border-color: black;
        border-width: 1px;
    }

    .divFinalAccount #bottom {
        border-bottom-style: solid;
        border-color: black;
        border-width: 1px;
    }

    .divFinalAccount #both {
        border-bottom-style: solid;
        border-top-style: solid;
        border-color: black;
        border-width: 1px;
    }

    .divFinalAccount #doublebottom {
        border-bottom-style: double;
        border-color: black;
    }

    .divFinalAccount #doublebottom2 {
        border-bottom-style: double;
        border-top-style: solid;
        border-color: black;
    }

    .divFinalAccount #total {
        border-bottom-style: double;
        border-top-style: solid;
        border-color: black;
        border-top-width: 1px;
    }

    .divFinalAccount tr.orange {
        backgRound-color: orange;
    }

    .divFinalAccount tr.red {
        backgRound-color: red;
    }

    .divFinalAccount .pagebefore {
        page-break-before: always;
    }

    .divFinalAccount .pageafter {
        page-break-after: always;
    }

    .pageafter {
        page-break-after: always;
    }


    .divFinalAccount .pagenever {
        page-break-after: avoid;
    }

    .divFinalAccount .pageboth {
        page-break-after: always;
        page-break-before: always;
    }

    .divFinalAccount #clientbutton {
        border-top: 1px;
        text-decoration: none;
        text-transform: uppercase;
        backgRound-color: navy;
        text-align: center;
        font-size: 11px;
        font-family: Verdana;
        padding: 4px;
        border-left: 1px;
        color: #FFF;
        font-weight: bold;
    }

    .divFinalAccount #clienttable {
        text-decoration: none;
        width: 70%;
        text-transform: uppercase;
        text-align: justify;
    }

    .divFinalAccount #clientheading {
        border-top: none;
        border-right: none;
        text-align: justify;
        font-size: 11px;
        font-family: Verdana;
        border-style: solid;
        padding: 4px;
        border-left: none;
        border-color: navy;
        font-weight: bold;
        border-width: 1px;
    }

    .divFinalAccount A {
        text-decoration: none;
    }

    @media screen {
        .divFinalAccount tr.odd {
            backgRound-color: #ddffdd;
        }

        .divFinalAccount A {
            font-weight: normal !important;
        }

        .divFinalAccount .footer {
            display: none;
        }

        .divFinalAccount .lastfooter {
            display: none;
        }
    }

    @media print {
        .divFinalAccount A {
            color: black;
        }

        .divFinalAccount table.footer {
            position: relative;
            top: -11mm;
        }

        .divFinalAccount .noprint {
            display: none;
        }

        .divFinalAccount table.header {
            position: relative;
            top: -11mm;
        }

        .divFinalAccount table.firstheader {
            margin-bottom: 11mm;
        }

        .divFinalAccount table.secondheader {
            position: relative;
            top: -11mm;
        }


        table.secondheader {
            position: relative;
            top: -11mm;
        }

        table.firstheader {
            margin-bottom: 11mm;
        }
    }

    /*Shanks Edits*/
    td {
        font: normal 15px 'Open Sans', sans-serif;
    }

    tr.spaceUnder > td {
        padding-bottom: 20em;
    }

    .custom_boldGrey {
        font: bold 15px 'Open Sans', sans-serif;
        color: #7d7d7d;
        display: block;
        min-width: 185px;
        float: left;
        margin-right: 5px;
    }

    table.table td {
        font: 'Open Sans', sans-serif;
        color: black;
    }

    tr.CompanyInfoTbl td.Order1 {
        width: 48%;
        text-align: justify;
        font: bold 15px 'Open Sans', sans-serif;
        padding-left: 15%;
    }

    tr.CompanyInfoTbl td.Order2 {
        width: 2%;
        text-align: center;
        font: bold 15px 'Open Sans', sans-serif;
    }

    tr.CompanyInfoTbl td.Order3 {
        width: 48%;
        text-align: justify;
        font: normal 15px 'Open Sans', sans-serif;
        padding-left: 2%;
        /*padding-left: 55%;*/
    }

    tr.textReport p {
        line-height: 20px !important;
        font: normal 15px 'Open Sans', sans-serif;
        color: black;
    }

    td.FullTotal {
        font-weight: bold !important;
        border-top: 1px solid black !important;
        border-bottom: 3px solid black !important;
        text-align: right !important;
    }

    td.FullTotalNumeric {
        font-weight: bold !important;
        border-top: 1px solid black !important;
        border-bottom: 3px solid black !important;
        text-align: right !important;
    }

    td.CategoryTotal {
        border-top: 1px solid black !important;
        text-align: right !important;
    }


    td.CategoryTotalNumeric {
        border-top: 1px solid black !important;
        text-align: right !important;
    }

    ul.bulletlist li {
        list-style-type: disc;
        list-style-position: outside;
        margin-left: 3%;
        /*padding-left: 2%;*/
        line-height: 20px;
    }

    ul.in-para li {
        margin-left: 20px;
        padding-left: 5px;
    }

    table.tb_dbhandled {
        border-collapse: collapse;
        table-layout: auto;
        width: 100%;
    }

        table.tb_dbhandled td {
            /*border: solid 1px #fab;*/
            word-wrap: break-word;
            padding: 1px 1px 1px 5px; /*T-R-B-L*/
            /*width: 100%;*/
        }

    td.numeric {
        text-align: right !important;
        font-family: 'Open Sans', sans-serif;
    }

    td.date {
        text-align: center !important;
    }

    .renderhtml td, .renderhtml {
        text-align: justify;
        font-family: 'Open Sans', sans-serif;
        /*padding: 0px 0px 0px 10px;*/
        margin: 0px 0px 0px 10px;
    }

    /* Report Outline - Generic Components */
    .statutoryinfo {
        font: bold 15px 'Open Sans', sans-serif !important;
        text-align: right;
    }

    .report_title {
        text-align: center;
        font: bold 20px 'Open Sans', sans-serif !important;
        color: #000;
    }

    .report_subtitle {
        text-align: center;
        font: bold 18px 'Open Sans', sans-serif;
    }

    .page_header {
        text-align: justify;
        font: bold 15px 'Open Sans', sans-serif;
    }

    td.page_header span.span_left {
        display: inline-block;
        text-align: justify;
        width: 70%;
        font: bold 15px 'Open Sans', sans-serif;
    }

    td.page_header span.span_right {
        display: inline-block;
        text-align: right;
        width: 28%;
    }

    .table_of_content_title {
        text-align: center;
        font: bold 18px 'Open Sans', sans-serif;
        color: black !important;
    }

    .page_title {
        text-align: center;
        font: bold 18px 'Open Sans', sans-serif;
        color: black;
    }

    .page_title_plm {
        text-align: center;
        font: bold 18px 'Open Sans', sans-serif;
        color: black;
    }

    .page_subtitle {
        text-align: center;
        line-height: 3;
        font: bold 15px 'Open Sans', sans-serif;
    }

    .page_subtitle_p {
        text-align: center;
        line-height: 3;
        font: bold 15px 'Open Sans', sans-serif;
    }

        .page_subtitle_p p {
            font-weight: bold;
        }

    .page_leftfootnote {
        text-align: justify;
        font: bold 15px 'Open Sans', sans-serif;
    }

    .page_rightfootnote {
        text-align: right;
        width: 100%;
        font: bold 15px 'Open Sans', sans-serif;
    }

    .page_centrefootnote {
        text-align: center;
        width: 100%;
        font: bold 15px 'Open Sans', sans-serif;
    }

    td.center, .center {
        text-align: center;
    }

    .dbText {
        font: bold 15px 'Open Sans', sans-serif;
        color: red;
    }

    /*divider*/
    margin_TopBottom8px {
        margin-top: 8px;
        margin-bottom: 8px;
    }

    td.list_items li.list_heading,
    tr.list_items li.list_heading {
        font-weight: bold;
    }

    td.list_items li.list_desc,
    tr.list_items li.list_desc {
        font-weight: normal;
        margin: 2px 0px 20px 0px;
        /*padding: 0px 0px 0px 10px;*/
    }

    .b {
        font-weight: bold !important;
    }

    .table_of_content_table td {
        cursor: default !important;
    }

    .page_content_Director {
        text-align: justify;
        font: bold 15px 'Open Sans', sans-serif;
    }

    .page_notetofinac_title {
        text-align: center;
        font: bold 18px 'Open Sans', sans-serif;
        color: black;
    }

    .page_notetofinac_subtitle {
        text-align: center;
        line-height: 3;
        font: bold 15px 'Open Sans', sans-serif;
    }

    .table_of_content_td_left {
        padding-left: 10%;
        font: 15px 'Open Sans', sans-serif;
        padding-top: 20px;
        text-align: justify;
    }

    .table_of_content_td_right {
        padding-right: 10%;
        font: 15px 'Open Sans', sans-serif;
        padding-top: 20px;
    }



    tr td.list_desc, tr td.b, .h1 td, .rowHighlight td, .bulletlist li span, .bulletlist li {
        text-align: justify;
        font: 15px 'Open Sans', sans-serif !important;
    }
    hr.headerLine {
        border-top: 2px solid black !important;
    }

    hr.headerLine {
        border-bottom: 0 !important;
    }

    .page_title h2 {
        color: #43a2a1;
        text-align: left;
    }

    #ctl00_divSubContent {
        background-color: #f7f7f7;
    }

    .listgp {
        position: fixed;
        top: 140px;
        right: 35px;
        border: 1px solid #43a2a1;
    }

    .list-group-item {
        border: 1px dashed #ddd;
        font-size: 15px !important;
    }

    a.list-group-item:hover {
        background-color: #126664 !important;
        color: #fff;
    }

    .lgActive {
        background-color: #43a2a1;
        color: #fff;
        border: 1px dashed #43a2a1;
        font-size: 15px !important;
    }

    .list-group-item:first-child {
        border-top-left-radius: 0px;
        border-top-right-radius: 0px;
    }

    a.list-group-item {
        color: #000;
    }

    .table > tbody > tr:last-child > td {
        border-bottom: solid 1px #f2f2f2;
    }

    .table > tbody > tr:first-child > td {
        border-top: solid 1px #f2f2f2;
    }

    .font-size-15 {
        font: normal 15px 'Open Sans', sans-serif !important;
    }

        .font-size-15 > p {
            font: normal 15px 'Open Sans', sans-serif !important;
            color: #000 !important;
        }

    table.tb_dbhandled td {
        font-size: 15px !important;
        color: #000 !important;
    }
</style>
